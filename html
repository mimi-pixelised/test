HTML 

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#f8fafc">
  <meta name="description" content="FlareMap — a simple fire and gas monitoring demonstration.">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="FlareMap">
  <title>FlareMap | Room dashboard</title>
  <link rel="icon" type="image/png" href="./icons/icon-192.png">
  <link rel="apple-touch-icon" href="./icons/icon-192.png">
  <link rel="manifest" href="./manifest.json">
  <link rel="stylesheet" href="./style.css">
</head>
<body>
  <header class="site-header" id="home">
    <div class="container header-inner">
      <div class="brand-wrapper">
        <button id="secretAdminTrigger" class="brand-icon" type="button" aria-label="FlareMap logo" title="FlareMap">
          <img src="./icons/icon-192.png" width="38" height="38" alt="">
        </button>
        <a class="brand-name" href="#home">Flare<span>Map</span><small>Room monitoring</small></a>
      </div>
      <nav class="nav-links" aria-label="Navigation">
        <a href="#dashboard">Overview</a>
        <a href="#notifications">Notifications</a>
      </nav>
      <button id="installAppButton" class="button button-outline install-button" type="button">
        Install app <span aria-hidden="true">↗</span>
      </button>
    </div>
  </header>

  <main class="container">
    <section class="page-intro" aria-labelledby="mainHeading">
      <div>
        <p class="eyebrow">FLAREMAP / ROOM 01</p>
        <h1 id="mainHeading">Room monitoring dashboard</h1>
        <p class="intro-subtitle">
          Temperature, humidity, gas and carbon monoxide readings in one place.
        </p>
      </div>
      <div class="demo-label"><span class="label-dot"></span> Demo mode</div>
    </section>

    <section class="notice" aria-label="Demonstration data notice">
      <span class="notice-icon" aria-hidden="true">i</span>
      <p><strong>Sample readings only.</strong> Values are simulated for your presentation; they are not from physical sensors and cannot detect real emergencies.</p>
    </section>

    <section id="dashboard" class="dashboard-section" aria-labelledby="overviewHeading">
      <div class="section-heading">
        <div>
          <h2 id="overviewHeading">Sensor overview</h2>
          <p>Readings automatically refresh every 5 seconds.</p>
        </div>
        <div class="updated">
          <span class="updated-dot"></span>
          <span id="lastUpdated">Loading sample readings…</span>
        </div>
      </div>

      <div class="sensor-grid">
        <article class="sensor-card temp-card">
          <div class="sensor-card-head">
            <span class="sensor-icon temp-icon" aria-hidden="true">°</span>
            <span class="sensor-model">DHT22</span>
          </div>
          <h3>Temperature</h3>
          <div class="sensor-value"><span id="temperature">--.-</span><small>°C</small></div>
          <div class="sensor-footer">
            <span>Ambient temperature</span>
            <svg class="sparkline" id="spark-temperature" viewBox="0 0 112 38" role="img" aria-label="Simulated temperature trend"></svg>
          </div>
        </article>

        <article class="sensor-card humidity-card">
          <div class="sensor-card-head">
            <span class="sensor-icon humidity-icon" aria-hidden="true">◉</span>
            <span class="sensor-model">DHT22</span>
          </div>
          <h3>Humidity</h3>
          <div class="sensor-value"><span id="humidity">--</span><small>%</small></div>
          <div class="sensor-footer">
            <span>Relative humidity</span>
            <svg class="sparkline" id="spark-humidity" viewBox="0 0 112 38" role="img" aria-label="Simulated humidity trend"></svg>
          </div>
        </article>

        <article class="sensor-card gas-card">
          <div class="sensor-card-head">
            <span class="sensor-icon gas-icon" aria-hidden="true">≋</span>
            <span class="sensor-model">MQ-5</span>
          </div>
          <h3>Gas sensor</h3>
          <div class="sensor-value"><span id="mq5">---</span><small>raw</small></div>
          <div class="sensor-footer">
            <span>Uncalibrated sample</span>
            <svg class="sparkline" id="spark-mq5" viewBox="0 0 112 38" role="img" aria-label="Simulated gas trend"></svg>
          </div>
        </article>

        <article class="sensor-card co-card">
          <div class="sensor-card-head">
            <span class="sensor-icon co-icon" aria-hidden="true">CO</span>
            <span class="sensor-model">MQ-7</span>
          </div>
          <h3>Carbon monoxide</h3>
          <div class="sensor-value"><span id="mq7">---</span><small>raw</small></div>
          <div class="sensor-footer">
            <span>Uncalibrated sample</span>
            <svg class="sparkline" id="spark-mq7" viewBox="0 0 112 38" role="img" aria-label="Simulated carbon monoxide trend"></svg>
          </div>
        </article>
      </div>
    </section>

    <div class="lower-grid">
      <section class="panel graph-panel" aria-labelledby="chartHeading">
        <div class="panel-header">
          <div>
            <h2 id="chartHeading">Sensor history</h2>
            <p>Recent simulated values</p>
          </div>
          <span class="mini-label">DEMO</span>
        </div>
        <div class="chart-tabs" role="group" aria-label="Choose sensor history">
          <button class="chart-tab active" type="button" data-sensor="temperature" aria-pressed="true">Temperature</button>
          <button class="chart-tab" type="button" data-sensor="humidity" aria-pressed="false">Humidity</button>
          <button class="chart-tab" type="button" data-sensor="mq5" aria-pressed="false">MQ-5</button>
          <button class="chart-tab" type="button" data-sensor="mq7" aria-pressed="false">MQ-7</button>
        </div>
        <div class="chart-current">
          <span id="chartLabel">Temperature</span>
          <strong id="chartCurrent">--</strong>
          <span id="chartUnit">°C</span>
        </div>
        <div class="chart-wrap">
          <svg id="trendChart" viewBox="0 0 720 230" preserveAspectRatio="none" role="img" aria-label="Sample sensor trend">
            <defs>
              <linearGradient id="chartFill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#f0866c" stop-opacity=".19"/>
                <stop offset="100%" stop-color="#f0866c" stop-opacity="0"/>
              </linearGradient>
            </defs>
            <g id="chartGrid"></g>
            <path id="chartArea" fill="url(#chartFill)"></path>
            <path id="chartLine" fill="none" stroke="#f0866c" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"></path>
            <circle id="chartDot" r="5.5" fill="#f0866c"></circle>
          </svg>
        </div>
        <div class="chart-axis"><span>Earlier</span><span>Latest</span></div>
      </section>

      <section class="panel notifications-panel" id="notifications" aria-labelledby="notificationsHeading">
        <div class="panel-header">
          <div>
            <h2 id="notificationsHeading">Notifications</h2>
            <p>Alerts from the FlareMap administrator</p>
          </div>
          <span class="bell-icon" aria-hidden="true">♧</span>
        </div>
        <div class="notification-explainer">
          <strong>Get updates on your device</strong>
          <p>Enable notifications to receive administrator messages on your phone or laptop.</p>
        </div>
        <div class="notification-state">
          <span class="state-dot" id="pushStateDot"></span>
          <span id="pushStatus">Notifications are off</span>
        </div>
        <button id="enablePushButton" class="button button-dark button-wide" type="button">Enable notifications</button>
        <p class="fine-print">Requires permission and a supported browser. On iPhone, add the website to the Home Screen first.</p>
        <div class="activity-heading">Latest notification</div>
        <div id="notificationActivity" class="activity-item">
          <span class="activity-dot"></span>
          <span>No notifications received yet.</span>
        </div>
        <p id="pushMessage" class="inline-message" role="status" aria-live="polite"></p>
      </section>
    </div>

    <section class="about-strip">
      <div>
        <h2>About this prototype</h2>
        <p>The DHT22, MQ-5 and MQ-7 readings are generated in the browser for demonstration purposes.</p>
      </div>
      <a class="button button-outline" target="_blank" rel="noopener noreferrer" href="https://www.tinkercad.com/things/4RoAIFNArjq-watery">
        View Tinkercad circuit <span aria-hidden="true">↗</span>
      </a>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <span>© 2026 FlareMap</span>
      <span>Educational prototype — not a real fire or gas alarm</span>
    </div>
  </footer>

  <!-- Hidden administrator controls -->
  <!-- The backend still verifies the user before sending notifications. -->
  <div id="adminOverlay" class="admin-overlay" hidden>
    <section class="admin-modal" role="dialog" aria-modal="true" aria-labelledby="adminHeading">
      <div class="modal-top">
        <div>
          <p class="eyebrow">PRIVATE ACCESS</p>
          <h2 id="adminHeading">Administrator panel</h2>
        </div>
        <button id="adminCloseButton" type="button" class="close-button" aria-label="Close administrator panel">×</button>
      </div>
      <p class="modal-subtitle">Sign in to send a FlareMap demonstration notification to subscribed devices.</p>

      <form id="adminLoginForm" novalidate>
        <label for="adminEmail">Administrator email</label>
        <input id="adminEmail" type="email" autocomplete="username" placeholder="Email address" required>
        <label for="adminPassword">Password</label>
        <input id="adminPassword" type="password" autocomplete="current-password" placeholder="Password" required>
        <button id="adminLoginButton" class="button button-dark button-wide" type="submit">Sign in</button>
        <button id="resendVerificationButton" class="subtle-button" type="button">Resend email verification</button>
      </form>

      <div id="adminControls" hidden>
        <div class="signed-in">
          <span aria-hidden="true">✓</span>
          <div>
            <strong>Administrator verified</strong>
            <small id="adminIdentity">Verified user</small>
          </div>
        </div>
        <input id="alertTitle" type="hidden" value="FlareMap demo notification">
        <label for="alertBody">Notification message</label>
        <textarea id="alertBody" rows="3" maxlength="220">This is a test notification sent by the FlareMap administrator.</textarea>
        <button id="broadcastAlarmButton" class="button button-alert button-wide" type="button">
          Send notification to devices
        </button>
        <button id="adminLogoutButton" class="subtle-button" type="button">Sign out</button>
        <p class="fine-print">Only devices that enabled notifications can receive this message. Delivery is not guaranteed.</p>
      </div>

      <p id="adminMessage" class="inline-message" role="status" aria-live="polite"></p>
    </section>
  </div>

  <div id="toast" class="toast" role="status" aria-live="polite" hidden></div>

  <script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js" defer></script>
  <script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-auth-compat.js" defer></script>
  <script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-functions-compat.js" defer></script>
  <script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-messaging-compat.js" defer></script>
  <script src="./app.js" defer></script>
</body>
</html>
